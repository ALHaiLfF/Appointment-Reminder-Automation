# ---------------------------------------------------------------------------
# .env.example
# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. Never commit the real
# `.env` file to version control -- it contains secrets.
#
#   cp .env.example .env
#
# See README.md -> "How to get a Gmail App Password" for SMTP_PASSWORD.
# ---------------------------------------------------------------------------

# --- SMTP / Gmail credentials -----------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-business-email@gmail.com
# 16-character Gmail App Password (NOT your normal Gmail password)
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_FROM_ADDRESS=your-business-email@gmail.com
EMAIL_SUBJECT_TEMPLATE=Reminder: Your appointment at {business_name} is tomorrow

# --- Business / branding -----------------------------------------------------
BUSINESS_NAME=Bright Smile Studio
BUSINESS_PHONE=+1 (555) 010-2020
BUSINESS_ADDRESS=12 Maple Street, Springfield
BUSINESS_BOOKING_URL=https://example.com/manage-booking
BUSINESS_LOGO_URL=https://dummyimage.com/120x120/4f46e5/ffffff.png&text=BS

# --- Timezone & scheduling window --------------------------------------------
# IANA timezone name the business operates in.
BUSINESS_TIMEZONE=Europe/Warsaw
REMINDER_WINDOW_MIN_HOURS=23
REMINDER_WINDOW_MAX_HOURS=25

# --- File paths (usually fine to leave as defaults) --------------------------
APPOINTMENTS_CSV_PATH=appointments.csv
EMAIL_TEMPLATE_DIR=templates

# --- Safety switch ------------------------------------------------------------
# When true, the script logs exactly what it would send but does not open an
# SMTP connection or modify appointments.csv. Great for demos and testing.
DRY_RUN=false
